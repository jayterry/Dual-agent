{
  "problem_id": "agent_full_coverage",
  "status": "open",
  "severity": "high",
  "source": "test_reports/agent_full_coverage/scenarios.json",
  "description": "Hybrid 五階段煙霧：Ingress、MessageFeatures、Validate、CAI 多輪（送審／缺正文／關係記憶／out_of_scope）、DAI call_dai。",
  "default_severity_on_fail": "fail",
  "test_design": {
    "rule": "Ingress → NLP(MessageFeatures) → Planner → Execute → ReAct",
    "coverage": {
      "ingress": ["審查進入", "SMS share", "複合 action", "拒絕句"],
      "message_features": ["review_sms", "ask_missing_body", "out_of_scope", "remember_relation"],
      "validate": ["meta 不搜尋", "pending_review", "送審無正文"],
      "cai_skills": ["ask_user", "call_dai", "profile_remember_relation", "profile_recall_relation", "confirm"],
      "cai_flows": ["身份短路", "送審兩輪", "pending_review 放棄", "out_of_scope 拒答"],
      "dai": ["call_dai 執行與 Replan 收尾"]
    }
  },
  "scenarios": [
    {
      "id": "ingress_review_and_action",
      "description": "Ingress：審查候選、送審正文、一般閒聊",
      "type": "ingress",
      "turns": [
        {
          "group": "baseline",
          "ref": "僅宣告收到簡訊",
          "user": "我收到一則簡訊",
          "expect": {
            "review_pending_candidate": true,
            "detected_task_type": "check",
            "requires_dai": false
          }
        },
        {
          "group": "baseline",
          "ref": "意圖+釣魚正文",
          "user": "幫我看這是不是詐騙：【XX銀行】您的帳戶異常，請點擊 https://fake.com",
          "expect": {
            "detected_task_type": "check",
            "requires_dai": true
          }
        },
        {
          "group": "control",
          "ref": "一般打招呼",
          "user": "你好",
          "expect": {
            "detected_task_type": "direct_response",
            "requires_dai": false,
            "review_pending_candidate": false
          }
        },
        {
          "group": "control",
          "ref": "拒絕句非候選",
          "user": "我沒有要你看簡訊",
          "expect": {
            "review_pending_candidate": false,
            "detected_task_type_not": "check"
          }
        },
        {
          "group": "control",
          "ref": "SMS share 有正文",
          "user": "【XX銀行】您的帳戶異常，請點擊 https://fake-bank.com 完成驗證",
          "input_origin": "sms_share",
          "expect": {
            "detected_task_type": "check",
            "requires_dai": true
          }
        },
        {
          "group": "baseline",
          "ref": "連結安全審查",
          "user": "幫我確認這個連結安不安全：https://bit.ly/abc",
          "expect": {
            "detected_task_type": "check",
            "requires_dai": true
          }
        }
      ]
    },
    {
      "id": "nlp_goals_and_gates",
      "description": "MessageFeatures：primary_goal 與技能白名單",
      "type": "message_features",
      "turns": [
        {
          "group": "baseline",
          "ref": "送審有正文",
          "user": "幫我看這是不是詐騙：https://x.com",
          "message_features": {
            "turn_intent": { "primary_goal": "review_sms" },
            "content": { "has_reviewable_body": true, "artifact_text": "https://x.com" },
            "gaps": { "missing_body_for_review": false }
          },
          "expect": {
            "primary_goal": "review_sms",
            "allowed_skills": ["ask_user", "call_dai", "confirm"]
          }
        },
        {
          "group": "baseline",
          "ref": "缺正文",
          "user": "我收到一則簡訊",
          "message_features": {
            "turn_intent": { "primary_goal": "ask_missing_body" },
            "gaps": { "missing_body_for_review": true }
          },
          "expect": {
            "primary_goal": "ask_missing_body",
            "allowed_skills": ["ask_user", "confirm"],
            "missing_body": true
          }
        },
        {
          "group": "control",
          "ref": "天氣 out_of_scope",
          "user": "幫我查高雄明天天氣",
          "message_features": {
            "turn_intent": { "primary_goal": "out_of_scope" },
            "gaps": { "out_of_product_scope": true }
          },
          "expect": {
            "primary_goal": "out_of_scope",
            "allowed_skills": ["confirm"],
            "out_of_product_scope": true
          }
        },
        {
          "group": "experimental",
          "ref": "記住關係",
          "user": "我媽媽叫 Yuri",
          "message_features": {
            "turn_intent": { "primary_goal": "remember_relation" },
            "social": { "relation_label": "媽媽", "relation_name": "Yuri", "mentions_relation": true }
          },
          "expect": {
            "primary_goal": "remember_relation",
            "allowed_skills": ["ask_user", "confirm", "profile_remember_relation"]
          }
        }
      ]
    },
    {
      "id": "validate_meta_and_review",
      "description": "Validate：meta 閒聊校正、pending_review、送審無正文",
      "type": "validate",
      "turns": [
        {
          "group": "baseline",
          "ref": "能力問句不應 search",
          "user": "我想知道你可以做甚麼",
          "planner_todos": [{ "skill": "search_web", "args": { "query": "你可以做甚麼" } }],
          "expect": { "task_type": "direct_response", "forbidden_skills": ["search_web"] }
        },
        {
          "group": "experimental",
          "ref": "pending_review 時 search 改 ask_user",
          "user": "你可以幫我看看嗎",
          "pending_review": true,
          "planner_todos": [{ "skill": "search_web", "args": { "query": "威脅簡訊" } }],
          "expect": { "task_type": "check", "skills": ["ask_user"] }
        }
      ]
    },
    {
      "id": "hybrid_identity_greeting",
      "description": "Hybrid：身份問答、打招呼（out_of_scope NLP）",
      "type": "plan_execute_multiturn",
      "session": "fresh",
      "mock": {
        "hybrid_enabled": true,
        "message_features_default": { "turn_intent": { "primary_goal": "out_of_scope" } },
        "planner_default": { "task_type": "direct_response", "todos": [] },
        "replan_default": { "complete": true, "final_answer": "我是 CAI 行動安全助理，協助檢視可疑訊息與詐騙風險。" }
      },
      "turns": [
        {
          "group": "control",
          "ref": "你是誰",
          "user": "你是誰",
          "expect": {
            "skills": [],
            "task_type": "direct_response",
            "answer_contains": ["CAI"]
          }
        },
        {
          "group": "control",
          "ref": "你好",
          "user": "你好",
          "message_features": { "turn_intent": { "primary_goal": "out_of_scope" } },
          "expect": {
            "skills": [],
            "pending_review": false
          }
        }
      ]
    },
    {
      "id": "hybrid_review_entry_ask",
      "description": "Hybrid：審查意圖無正文 → ask_user + pending_review",
      "type": "plan_execute_multiturn",
      "session": "fresh",
      "mock": {
        "hybrid_enabled": true,
        "planner_default": { "task_type": "action", "todos": [] },
        "replan_default": { "complete": true, "final_answer": "不應走到這裡。" }
      },
      "turns": [
        {
          "group": "baseline",
          "ref": "怪怪的訊息",
          "user": "我收到一個怪怪的訊息",
          "message_features": {
            "turn_intent": { "primary_goal": "ask_missing_body" },
            "gaps": { "missing_body_for_review": true }
          },
          "expect": {
            "skills": ["ask_user"],
            "pending_review": true,
            "task_type": "check"
          }
        },
        {
          "group": "baseline",
          "ref": "僅宣告簡訊",
          "user": "我收到一則簡訊",
          "message_features": {
            "turn_intent": { "primary_goal": "ask_missing_body" },
            "gaps": { "missing_body_for_review": true }
          },
          "expect": {
            "skills": ["ask_user"],
            "pending_review": true
          }
        }
      ]
    },
    {
      "id": "hybrid_pending_review_lifecycle",
      "description": "Hybrid：pending_review 進入→放棄→out_of_scope",
      "type": "plan_execute_multiturn",
      "session": "fresh",
      "mock": {
        "hybrid_enabled": true,
        "planner_default": { "task_type": "direct_response", "todos": [] },
        "replan_default": {
          "complete": true,
          "final_answer": "我主要協助檢視可疑訊息與詐騙風險。"
        }
      },
      "turns": [
        {
          "group": "baseline",
          "ref": "進入待審",
          "user": "我收到一則簡訊",
          "message_features": {
            "turn_intent": { "primary_goal": "ask_missing_body" },
            "gaps": { "missing_body_for_review": true }
          },
          "expect": { "skills": ["ask_user"], "pending_review": true }
        },
        {
          "group": "baseline",
          "ref": "拒絕送審",
          "user": "我沒有要你看簡訊",
          "message_features": { "turn_intent": { "primary_goal": "out_of_scope" } },
          "expect": { "pending_review": false, "forbid_review_ask_user": true }
        },
        {
          "group": "experimental",
          "ref": "out_of_scope 天氣",
          "user": "台灣台中市明天的天氣",
          "message_features": {
            "turn_intent": { "primary_goal": "out_of_scope" },
            "gaps": { "out_of_product_scope": true }
          },
          "expect": { "skills": [], "forbid_review_ask_user": true }
        }
      ]
    },
    {
      "id": "hybrid_review_to_dai",
      "description": "Hybrid→DAI：意圖句 ask_user → 補正文 call_dai",
      "type": "plan_execute_multiturn",
      "session": "fresh",
      "mock": {
        "hybrid_enabled": true,
        "planner_responses": [
          {
            "task_type": "check",
            "task_state": "running",
            "todos": [
              {
                "skill": "call_dai",
                "args": {
                  "artifact": "【XX銀行】您的帳戶異常，請點擊 https://fake-bank.com 完成驗證",
                  "sms_review": true
                }
              }
            ]
          }
        ],
        "execute_step": "call_dai_success",
        "replan_default": {
          "complete": true,
          "final_answer": "風險分數：75/100，建議提高警覺。",
          "task_state": "completed"
        }
      },
      "turns": [
        {
          "group": "baseline",
          "ref": "意圖無正文",
          "user": "我剛剛收到一個簡訊，有點奇怪",
          "message_features": {
            "turn_intent": { "primary_goal": "ask_missing_body" },
            "gaps": { "missing_body_for_review": true }
          },
          "expect": { "skills": ["ask_user"], "pending_review": true }
        },
        {
          "group": "experimental",
          "ref": "補釣魚正文",
          "user": "【XX銀行】您的帳戶異常，請點擊 https://fake-bank.com 完成驗證",
          "message_features": {
            "turn_intent": { "primary_goal": "review_sms" },
            "content": {
              "has_reviewable_body": true,
              "artifact_text": "【XX銀行】您的帳戶異常，請點擊 https://fake-bank.com 完成驗證"
            },
            "gaps": { "missing_body_for_review": false }
          },
          "expect": { "skills": ["call_dai"] }
        }
      ]
    },
    {
      "id": "hybrid_scam_url_direct",
      "description": "Hybrid：意圖+URL 一輪送審 call_dai",
      "type": "plan_execute_multiturn",
      "session": "fresh",
      "mock": {
        "hybrid_enabled": true,
        "planner_default": {
          "task_type": "check",
          "todos": [
            {
              "skill": "call_dai",
              "args": { "artifact": "https://x.com", "sms_review": true }
            }
          ]
        },
        "execute_step": "call_dai_success",
        "replan_default": {
          "complete": true,
          "final_answer": "已審查完成。",
          "task_state": "completed"
        }
      },
      "turns": [
        {
          "group": "control",
          "ref": "單輪 mixed 送審",
          "user": "幫我看這是不是詐騙：https://x.com",
          "message_features": {
            "turn_intent": { "primary_goal": "review_sms" },
            "content": { "has_reviewable_body": true, "artifact_text": "https://x.com" }
          },
          "expect": { "skills": ["call_dai"] }
        }
      ]
    },
    {
      "id": "hybrid_remember_relation",
      "description": "Hybrid：記住關係 → profile_remember_relation",
      "type": "plan_execute_multiturn",
      "session": "fresh",
      "mock": {
        "hybrid_enabled": true,
        "planner_default": {
          "task_type": "direct_response",
          "todos": [
            {
              "skill": "profile_remember_relation",
              "args": {
                "relation_label": "媽媽",
                "relation_name": "Yuri",
                "mode": "set"
              }
            }
          ]
        },
        "execute_step": "noop_ok",
        "replan_default": { "complete": true, "final_answer": "好的，我記住了。" }
      },
      "turns": [
        {
          "group": "baseline",
          "ref": "宣告關係",
          "user": "我媽媽叫 Yuri",
          "message_features": {
            "turn_intent": { "primary_goal": "remember_relation" },
            "social": { "relation_label": "媽媽", "relation_name": "Yuri", "mentions_relation": true }
          },
          "expect": {
            "skills": ["profile_remember_relation"],
            "executed_skills": ["profile_remember_relation"]
          }
        }
      ]
    },
    {
      "id": "hybrid_it_career_out_of_scope",
      "description": "IT 閒聊：out_of_scope，不得 call_dai",
      "type": "plan_execute_multiturn",
      "session": "fresh",
      "mock": {
        "hybrid_enabled": true,
        "planner_responses": [
          {
            "task_type": "check",
            "task_state": "running",
            "todos": [{ "skill": "call_dai", "args": {} }],
            "message": "需要審查"
          }
        ],
        "replan_default": {
          "complete": true,
          "final_answer": "我主要協助檢視可疑訊息與詐騙風險。",
          "task_state": "completed"
        }
      },
      "turns": [
        {
          "group": "baseline",
          "ref": "IT 猜專業方向",
          "user": "做it有很多方面，你猜是哪個方面的",
          "message_features": {
            "turn_intent": { "primary_goal": "out_of_scope" },
            "gaps": { "out_of_product_scope": true }
          },
          "expect": {
            "forbidden_skills": ["call_dai"],
            "forbid_review_ask_user": true,
            "pending_review": false,
            "skills": []
          }
        }
      ]
    }
  ]
}
